#!/usr/bin/python3
"""CLI tool to configure the Evoluent horizontal scroll daemon."""

import argparse
import json
import os
import signal
import sys
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "evoluent" / "config.json"

DEFAULT_CONFIG = {
    "sensitivity": 5,
    "accumulator_threshold": 15,
    "acceleration": False,
}


def load_config():
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    if not CONFIG_PATH.exists():
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return dict(DEFAULT_CONFIG)
    with open(CONFIG_PATH) as f:
        return json.load(f)


def save_config(cfg):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2) + "\n")


def find_daemon_pid():
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            cmdline = (entry / "cmdline").read_bytes().decode()
            if "evoluent-hscroll" in cmdline:
                pid = int(entry.name)
                if pid != os.getpid():
                    return pid
        except (PermissionError, FileNotFoundError, ProcessLookupError):
            continue
    return None


def reload_daemon():
    pid = find_daemon_pid()
    if pid:
        os.kill(pid, signal.SIGHUP)
        print(f"Sent SIGHUP to daemon (PID {pid})")
    else:
        print("Daemon not running — changes will apply on next start")


def cmd_get(args):
    cfg = load_config()
    print(json.dumps(cfg, indent=2))


def cmd_set(args):
    cfg = load_config()
    key = args.key
    value = args.value

    if key == "sensitivity":
        v = int(value)
        if not 1 <= v <= 20:
            print("sensitivity must be 1-20", file=sys.stderr)
            sys.exit(1)
        cfg["sensitivity"] = v
    elif key == "threshold":
        v = int(value)
        if not 1 <= v <= 50:
            print("threshold must be 1-50", file=sys.stderr)
            sys.exit(1)
        cfg["accumulator_threshold"] = v
    else:
        print(f"Unknown key: {key}", file=sys.stderr)
        sys.exit(1)

    save_config(cfg)
    print(f"Set {key} = {value}")
    reload_daemon()


def main():
    parser = argparse.ArgumentParser(description="Configure Evoluent horizontal scroll daemon")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("get", help="Print current config")

    set_parser = sub.add_parser("set", help="Update a config value")
    set_parser.add_argument("key", choices=["sensitivity", "threshold"])
    set_parser.add_argument("value")

    args = parser.parse_args()
    if args.command == "get":
        cmd_get(args)
    elif args.command == "set":
        cmd_set(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
